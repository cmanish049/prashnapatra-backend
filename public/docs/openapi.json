{
  "openapi": "3.0.3",
  "info": {
    "title": "OldIsGold API",
    "description": "API documentation for OldIsGold application",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "API v1"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/universities": {
      "get": {
        "tags": ["Universities"],
        "summary": "List all universities",
        "description": "Returns a list of all universities",
        "operationId": "listUniversities",
        "parameters": [
          {
            "$ref": "#/components/parameters/AcceptEncoding"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "error": {
                      "type": "boolean",
                      "example": false
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/University"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid or missing API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Unauthorized"
                }
              }
            }
          }
        }
      }
    },
    "/universities/{universityId}/programs": {
      "get": {
        "tags": ["Programs"],
        "summary": "List programs for a university",
        "description": "Returns a list of programs associated with a specific university",
        "operationId": "listUniversityPrograms",
        "parameters": [
          {
            "name": "universityId",
            "in": "path",
            "description": "ID of the university",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "$ref": "#/components/parameters/AcceptEncoding"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "error": {
                      "type": "boolean",
                      "example": false
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Program"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid or missing API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Unauthorized"
                }
              }
            }
          },
          "404": {
            "description": "University not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/subjects": {
      "get": {
        "tags": ["Subjects"],
        "summary": "List all subjects",
        "description": "Returns a paginated list of all subjects with their university and program. Supports filtering by university, program, and semester.",
        "operationId": "listSubjects",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "university",
            "in": "query",
            "description": "Filter by university ID",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "program",
            "in": "query",
            "description": "Filter by program ID",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "semester",
            "in": "query",
            "description": "Filter by semester number",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "perPage",
            "in": "query",
            "description": "Number of items per page (default: 20, max: 100)",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "$ref": "#/components/parameters/AcceptEncoding"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "error": {
                      "type": "boolean",
                      "example": false
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SubjectWithRelations"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid or missing API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Unauthorized"
                }
              }
            }
          }
        }
      }
    },
    "/subjects/{subjectId}": {
      "get": {
        "tags": ["Subjects"],
        "summary": "Get subject details",
        "description": "Returns detailed information about a specific subject including its university and program",
        "operationId": "showSubject",
        "parameters": [
          {
            "name": "subjectId",
            "in": "path",
            "description": "ID of the subject",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "$ref": "#/components/parameters/AcceptEncoding"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "error": {
                      "type": "boolean",
                      "example": false
                    },
                    "data": {
                      "$ref": "#/components/schemas/SubjectWithRelations"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid or missing API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Unauthorized"
                }
              }
            }
          },
          "404": {
            "description": "Subject not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "University": {
        "type": "object",
        "properties": {
          "university_id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Tribhuvan University"
          },
          "label": {
            "type": "string",
            "example": "tu"
          }
        }
      },
      "Program": {
        "type": "object",
        "properties": {
          "program_id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Bachelor of Computer Science"
          },
          "abbreviation": {
            "type": "string",
            "example": "BCS"
          }
        }
      },
      "Subject": {
        "type": "object",
        "properties": {
          "subject_id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Data Structures and Algorithms"
          },
          "code": {
            "type": "string",
            "example": "CSC201"
          },
          "semester": {
            "type": "integer",
            "example": 3
          },
          "credit": {
            "type": "integer",
            "example": 4
          },
          "syllabus_url": {
            "type": "string",
            "example": "https://example.com/syllabus/csc201.pdf"
          }
        }
      },
      "SubjectWithRelations": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Subject"
          },
          {
            "type": "object",
            "properties": {
              "university": {
                "$ref": "#/components/schemas/University"
              },
              "program": {
                "$ref": "#/components/schemas/Program"
              }
            }
          }
        ]
      },
      "PaginationLinks": {
        "type": "object",
        "properties": {
          "first": {
            "type": "string",
            "example": "/api/v1/subjects?page=1"
          },
          "last": {
            "type": "string",
            "example": "/api/v1/subjects?page=5"
          },
          "prev": {
            "type": "string",
            "nullable": true,
            "example": null
          },
          "next": {
            "type": "string",
            "nullable": true,
            "example": "/api/v1/subjects?page=2"
          }
        }
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "current_page": {
            "type": "integer",
            "example": 1
          },
          "from": {
            "type": "integer",
            "example": 1
          },
          "per_page": {
            "type": "integer",
            "example": 20
          },
          "to": {
            "type": "integer",
            "example": 20
          },
          "path": {
            "type": "string",
            "example": "/api/v1/subjects"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "error": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "University not found"
          }
        }
      },
      "Unauthorized": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "error": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Invalid or missing API key"
          }
        }
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API key for authentication"
      }
    },
    "parameters": {
      "AcceptEncoding": {
        "name": "Accept-Encoding",
        "in": "header",
        "description": "Request gzip compression for the response",
        "required": false,
        "schema": {
          "type": "string",
          "example": "gzip"
        }
      }
    }
  }
}
